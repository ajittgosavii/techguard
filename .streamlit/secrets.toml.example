# TechGuardrails - Streamlit Cloud Secrets Configuration
# Copy this content to Streamlit Cloud Secrets in your app settings
# Settings > Secrets > Paste and Save

# =====================================================
# ANTHROPIC API CONFIGURATION (for AI Features)
# =====================================================
[anthropic]
api_key = "YOUR_ANTHROPIC_API_KEY"
model_id = "claude-sonnet-4-20250514"
max_tokens = 2000
temperature = 0.7

# Available models:
# - claude-sonnet-4-20250514 (recommended - latest)
# - claude-3-5-sonnet-20241022 (previous generation)
# - claude-3-haiku-20240307 (faster, cheaper)

# Get your API key at: https://console.anthropic.com/

# =====================================================
# AWS CREDENTIALS (Optional - for Organizations/SecurityHub sync)
# =====================================================
[aws]
access_key_id = "YOUR_AWS_ACCESS_KEY_ID"
secret_access_key = "YOUR_AWS_SECRET_ACCESS_KEY"
region = "us-east-1"

# Optional: For cross-account access
# assume_role_arn = "arn:aws:iam::123456789012:role/TechGuardrailsRole"

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
[database]
type = "sqlite"
url = "sqlite:///techguardrails.db"

# For persistent storage, use PostgreSQL:
# Option 1: Supabase (Free tier available)
# type = "postgresql"
# url = "postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Option 2: Neon (Free tier available)
# type = "postgresql"
# url = "postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require"

# Option 3: AWS RDS
# type = "postgresql"
# url = "postgresql://user:password@your-rds-endpoint:5432/techguardrails"

# =====================================================
# APPLICATION SETTINGS
# =====================================================
[app]
# Default data mode: 'demo' for sample data, 'live' for real AWS data
default_mode = "demo"

# Auto-remediation - set to true to enable automatic fixes
enable_auto_remediation = false

# =====================================================
# FINOPS CONFIGURATION
# =====================================================
[finops]
enabled = true
budget_alert_threshold = 80
cost_anomaly_threshold = 20
